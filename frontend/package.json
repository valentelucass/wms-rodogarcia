{
    "name": "wms-rodogarcia-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24.13.0"
    },
    "scripts": {
        "dev": "vite --config vite.dev.config.ts --mode real",
        "dev:ficticio": "vite --config vite.dev.config.ts --mode ficticio",
        "preview": "node tools/preview.mjs",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && vite build",
        "build:ficticio": "npm run typecheck && vite build --mode ficticio",
        "lint": "eslint src tests dev tools/*.mjs *.ts *.js",
        "test": "vitest run",
        "test:browser": "playwright test",
        "check": "npm run typecheck && npm run lint && npm test && npm run build"
    },
    "dependencies": {
        "lossless-json": "4.3.1",
        "qrcode": "1.5.4",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.0.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jsdom": "^29.0.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "vite": "8.3.4",
        "vitest": "5.0.3"
    }
}
