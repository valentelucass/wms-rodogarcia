# Build Java/Maven, inclusive diretórios alternativos usados nas validações.
**/target/
/backend/target-*/
*.class
*.jar
*.jar.original
*.jar.historico
*.war
*.ear
!**/.mvn/wrapper/maven-wrapper.jar

# Dependências e saídas do frontend; manifests e lockfiles permanecem versionáveis.
node_modules/
/frontend/dist/
/frontend/build/
/frontend/.vite/
coverage/
*.tsbuildinfo

# Configuração local, segredos e logs.
.env
.env.*
!.env.example
!.env.*.example
*.log
*.log.*
/backend/config/

# IDEs, sistema operacional e temporários.
.idea/
*.iml
.classpath
.project
.settings/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.bak-*

# Ferramentas de IA, habilidades instaladas e orquestração desta máquina.
# AGENTS.md, STATES.md e docs/ continuam como documentação do projeto.
.agents/
.codex/
.maestri/
/orchestracao/
/.ai-memory.toml
/.graphifyignore
.graphify/
/graphify-out/

# Ambientes e caches das ferramentas locais.
__pycache__/
*.py[cod]
.venv/
.tools/
*.mcp-tools.tmp

# Evidências brutas geradas localmente: JSONs, XMLs e cópias de arquivos.
# Preservar os arquivos no disco; relatórios, manifestos SHA-256 e scripts de
# conferência atuais seguem versionáveis. As migrations oficiais ficam em
# database/migrations, fora destas regras.
/backend/evidencias/*.json
/backend/evidencias/*-xml-*/
/database/evidencias/*.json
/database/evidencias/*.sql
# Cópia histórica da V8 salva sem extensão.
/database/evidencias/d19-v8-2026-10-06-p2-origem-final
/infra/evidencias/*.json
/docs/evidencias/*.json
/database/evidencias/*-antes*.ps1
/database/evidencias/*-antes*.md
/database/evidencias/*-fonte-*.md
/infra/evidencias/*-antes*.ps1
/infra/evidencias/*-antes-*.md

# Relatos de falhas anteriores são evidências escritas, não cópias dos fontes.
!/database/evidencias/*-antes-correcao.md
!/infra/evidencias/*-relato-antes-fecho.md

# Runtime e material de autenticação local (inclusive fixtures cifradas).
.runtime/
*.clixml
*.key
*.pfx
*.p12
*.jks
*.keystore
.npmrc
.netrc
application-*.local.properties

# Relatórios automatizados, caches e dumps que podem conter dados em memória.
test-results/
test-results-*/
playwright-report/
blob-report/
.cache/
*.mdmp
*.hprof
hs_err_pid*
replay_pid*

# Pacotes e snapshots de ensaios; preservar os originais locais e os relatos.
/backend/evidencias/*.zip
/backend/evidencias/d30-*/
/backend/evidencias/*-settings.xml
/frontend/evidencias/*.zip
/frontend/evidencias/snapshot-*/
/frontend/evidencias/contratos-antes-*/
/frontend/evidencias/marco*-preservado/
/frontend/evidencias/handoff-*/
/database/evidencias/fixtures/*
!/database/evidencias/fixtures/.gitignore

# Outros formatos de credencial e dados locais; certificados públicos não são segredos.
*.pem
*.ppk
*.dpapi
*.secret
*.secrets
id_rsa
id_ed25519
credentials.json
secrets.json
*.har
*.h2.db
*.mv.db
*.trace.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.dmp
*.dump
*.bkp
*.trn
/frontend/.vite-*/

# Cópias de fontes e resultados de execução não são fontes oficiais.
/backend/evidencias/*-xml/
/backend/evidencias/*-surefire/
/backend/evidencias/d29-retomada-fontes-build*/
/backend/evidencias/d29-fecho-local-cedro-build*/
/backend/evidencias/d29-testes-*/
/backend/evidencias/*.xlsx
/backend/evidencias/**/d*-maven-config-*.xml
/backend/evidencias/**/*.json
/database/evidencias/*-snapshot-*/
/frontend/evidencias/*-snapshot*/
/frontend/evidencias/prumo-css-*/cache-*/
/frontend/evidencias/prumo-css-*/dist-*/
/frontend/evidencias/prumo-css-*/*source*/
/frontend/evidencias/**/browser*.png
/frontend/evidencias/**/*-browser-*.png
/frontend/evidencias/**/*.json
/frontend/evidencias/**/*.png

# Evidências locais em qualquer pasta do projeto.
evidencias/
