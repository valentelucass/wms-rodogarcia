<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>br.com.rodogarcia</groupId>
    <artifactId>wms-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>WMS Rodogarcia</name>
    <description>Backend do WMS Rodogarcia em Spring MVC por camadas</description>
    <properties>
        <java.version>21</java.version>
        <wms.build.directory>${project.basedir}/target</wms.build.directory>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-10-05T00:00:00Z</project.build.outputTimestamp>
        <archunit.version>1.5.1</archunit.version>
        <spotless.version>3.10.3</spotless.version>
        <google-java-format.version>1.28.0</google-java-format.version>
        <maven-enforcer.version>3.6.3</maven-enforcer.version>
        <wms.migrations.skip>true</wms.migrations.skip>
        <wms.migrations.initSql>THROW 51002, 'Guarda de migrations ausente. Use o wrapper WMS.', 1;</wms.migrations.initSql>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <directory>${wms.build.directory}</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <executions>
                    <execution>
                        <id>ferramentas-suportadas</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Use JDK 21 e configure JAVA_HOME antes de executar o wrapper.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.16,4)</version>
                                    <message>Use o Maven Wrapper versionado neste projeto.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <lineEndings>UNIX</lineEndings>
                    <java>
                        <forbidWildcardImports/>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>conferir-formatacao</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>migrations-wrapper-confirmado</id>
            <activation>
                <property>
                    <name>env.WMS_DB_MIGRATION_GUARD</name>
                    <value>D20_WMS_DEV_VERIFICADO</value>
                </property>
            </activation>
            <properties>
                <wms.migrations.initSql>${env.WMS_DB_MIGRATION_INIT_SQL}</wms.migrations.initSql>
            </properties>
        </profile>
        <profile>
            <id>sqlserver-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <configuration>
                            <includes><include>**/SqlServerLocalIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>migrations</id>
            
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>alvo-migrations-d20</id>
                                <phase>validate</phase>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireEnvironmentVariable>
                                            <variableName>WMS_DB_NAME</variableName>
                                            <regex>WMS_DEV</regex>
                                            <message>Migrations D20 exigem WMS_DEV; use o wrapper guardado.</message>
                                            <regexMessage>Migrations D20 exigem WMS_DEV.</regexMessage>
                                        </requireEnvironmentVariable>
                                        <requireEnvironmentVariable>
                                            <variableName>WMS_DB_MIGRATION_GUARD</variableName>
                                            <regex>D20_WMS_DEV_VERIFICADO</regex>
                                            <message>Use o wrapper com alvo e configuracao efetiva conferidos.</message>
                                            <regexMessage>Guarda de migrations ausente ou divergente.</regexMessage>
                                        </requireEnvironmentVariable>
                                        <requireEnvironmentVariable>
                                            <variableName>WMS_DB_MIGRATION_INIT_SQL</variableName>
                                            <regex>(?s).+</regex>
                                            <message>SQL transitório de guarda obrigatorio; use o wrapper.</message>
                                            <regexMessage>SQL transitório de guarda vazio.</regexMessage>
                                        </requireEnvironmentVariable>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <version>${flyway.version}</version>
                        <configuration>
                            <skip>${wms.migrations.skip}</skip>
                            <url>jdbc:sqlserver://${env.WMS_DB_HOST}:${env.WMS_DB_PORT};databaseName=WMS_DEV;encrypt=true;trustServerCertificate=false</url>
                            <user>${env.WMS_DB_MIGRATION_USER}</user>
                            <password>${env.WMS_DB_MIGRATION_PASSWORD}</password>
                            <schemas><schema>wms</schema></schemas>
                            <defaultSchema>wms</defaultSchema>
                            <locations><location>filesystem:${project.basedir}/../database/migrations</location></locations>
                            <cleanDisabled>true</cleanDisabled>
                            <baselineOnMigrate>false</baselineOnMigrate>
                            <validateOnMigrate>true</validateOnMigrate>
                            <outOfOrder>false</outOfOrder>
                            <validateMigrationNaming>true</validateMigrationNaming>
                            <initSql>${wms.migrations.initSql}</initSql>
                            <placeholders><wmsDatabase>WMS_DEV</wmsDatabase></placeholders>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.flywaydb</groupId>
                                <artifactId>flyway-sqlserver</artifactId>
                                <version>${flyway.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>com.microsoft.sqlserver</groupId>
                                <artifactId>mssql-jdbc</artifactId>
                                <version>${mssql-jdbc.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
